{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mflux WebUI",
  "version": "0.1.0",
  "identifier": "io.github.wyf0931.mflux-webui",
  "build": {
    "beforeDevCommand": "npm run desktop:prepare",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../build/desktop/frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "files": { "Resources/backend": "../build/desktop/backend" },
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true
    }
  }
}
