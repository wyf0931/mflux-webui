{
  "name": "mflux-webui",
  "version": "1.0.0",
  "description": "一个基于 Flask 的本地 mflux 图像生成界面。V1 专注于 **Krea 2 Turbo**：支持文生图、文 + 图生图、生成画廊，以及本机 Hugging Face（HF）模型缓存查看。",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./static/css/input.css -o ./static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./static/css/input.css -o ./static/css/app.css --watch",
    "build:js": "esbuild static/js/main.js --bundle --minify --outfile=static/js/app.js",
    "build": "npm run build:css && npm run build:js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyf0931/mflux-webui.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/wyf0931/mflux-webui/issues"
  },
  "homepage": "https://github.com/wyf0931/mflux-webui#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.17",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "alpinejs": "^3.16.2"
  }
}
