{
  "name": "mflux-webui",
  "version": "1.0.0",
  "description": "一个基于 Flask 与 mflux 的本地图像生成 WebUI，支持 Qwen Image 2.1 Turbo、Krea 2 Turbo、Z-Image Turbo 与 FLUX.2 Klein。",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./mflux_webui/static/css/input.css -o ./mflux_webui/static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./mflux_webui/static/css/input.css -o ./mflux_webui/static/css/app.css --watch",
    "build:js": "esbuild mflux_webui/static/js/main.js --bundle --minify --outfile=mflux_webui/static/js/app.js",
    "build": "npm run build:css && npm run build:js",
    "desktop:prepare": "npm run build && uv run --locked --group desktop python scripts/build_desktop_backend.py",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyf0931/mflux-webui.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/wyf0931/mflux-webui/issues"
  },
  "homepage": "https://github.com/wyf0931/mflux-webui#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/cli": "^2.12.2",
    "daisyui": "^5.7.17",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "alpinejs": "^3.16.2"
  }
}
